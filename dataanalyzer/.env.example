# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- branding and port
ORG_NAME=Punjab National Bank
ORG_SHORT=PNB
ORG_UNIT=Data Analytics and Strategic Innovation Division
APP_NAME=PNB Data Analyzer
# Port the app listens on. 8095 avoids vLLM (8000), the Data Summarizer (8090)
# and Peer Benchmarking (8077).
PORT=8095
PUBLIC_URL=http://localhost:8095

# ---------------------------------------------------------------- Executive Intelligence Hub
# The hub signs the person in and opens this app inside its workspace, under the name
# "Data Analyzer". It asks this server for a single-use ticket, with the secret below,
# and the frame swaps that ticket for a session of this app.
# One-click sign-in from the hub. Leave empty to switch it off.
# Must be a long random string (32+ characters) shared ONLY with the hub's server.
# The setup script fills this in, with the same value as ANALYZER_HANDOFF_SECRET in
# the backend's .env.
HANDOFF_SECRET=
# How long a sign-in ticket is valid, in seconds (it can be used once).
HANDOFF_TICKET_SECONDS=120
# Which sites may drive this app. The hub's own address.
EMBED_PARENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Which sites may call the API from a browser (comma separated). The hub's address.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Which sites may show this app in an iframe. "*" = any. In production list the hub's
# address, e.g. FRAME_ANCESTORS=https://tmd.pnb.bank.in
FRAME_ANCESTORS=*

# ---------------------------------------------------------------- security
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=480

# ---------------------------------------------------------------- the documents
# The largest document that is accepted, in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400
# How many rows are shown in the preview of a document.
PREVIEW_ROWS=50

# ---------------------------------------------------------------- language model
# "auto" uses the best model that is installed on this machine, which is what most
# machines want. Name a model to pin it, for example LLM_MODEL=qwen3:8b.
LLM_MODEL=auto
# When a model is named but not installed, the best model that is installed is used
# instead. Set this to true to refuse to use anything else.
LLM_STRICT_MODEL=false
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Where the models of this machine are listed: Ollama's own address, without /v1.
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# ---------------------------------------------------------------- storage
# Empty = SQLite in data/. For PostgreSQL: postgresql+psycopg://user:pass@host:5432/analyzer
DATABASE_URL=
LOG_LEVEL=INFO

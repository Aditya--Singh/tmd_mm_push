# The Data Analyzer of the Executive Intelligence Hub.
#
# Copy to .env and fill in. Never commit .env. The setup script writes this file for
# you, with the port and the model this machine really has.

# ---------------------------------------------------------------- the port
# The port the app listens on. 8095 avoids vLLM (8000), the Data Summarizer (8090)
# and Peer Benchmarking (8077).
PORT=8095

# ---------------------------------------------------------------- security
# The app's own signing key, for the tokens it issues.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=480

# ---------------------------------------------------------------- Executive Intelligence Hub
# The hub signs the person in and opens this app inside its workspace, under the name
# "Data Analyzer". It asks this server for a single-use ticket, with the secret below,
# and the frame swaps that ticket for a session of this app.
# Must be a long random string (32+ characters) shared ONLY with the hub's server.
# The setup script fills this in, with the same value as ANALYZER_HANDOFF_SECRET in
# the backend's .env.
HANDOFF_SECRET=
# How long a sign-in ticket is valid, in seconds (it can be used once).
HANDOFF_TICKET_SECONDS=120
# Which sites may drive this app over the message bridge. The hub's own address.
EMBED_PARENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://topmgmtdash.pnbbank.in:5174
# Which sites may call the API from a browser (comma separated). The hub's address.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://topmgmtdash.pnbbank.in:5174
# Which sites may show this app in an iframe. In production, list the hub's address,
# e.g. FRAME_ANCESTORS=https://tmd.pnb.bank.in
FRAME_ANCESTORS=http://localhost:5174,http://127.0.0.1:5174,http://topmgmtdash.pnbbank.in:5174

# ---------------------------------------------------------------- the language model
# The local model server. Only a local host is used, so no document leaves this machine.
OLLAMA_URL=http://localhost:11434
# The model to use. The setup script writes the best model that is really installed.
OLLAMA_MODEL=
# The size of the context window. Ollama otherwise uses a small one and quietly drops
# the start of any prompt that does not fit.
OLLAMA_NUM_CTX=32768

# ---------------------------------------------------------------- the grammar checker
# LanguageTool is optional: the app works without it and says so. The upstream runs it
# in Docker on this port.
LANGUAGETOOL_URL=http://localhost:8120
LANGUAGETOOL_LANGUAGE=en-GB

# ---------------------------------------------------------------- the uploads
# The largest document that is accepted, in megabytes.
MAX_UPLOAD_MB=20
# Where the uploaded documents are kept. Empty = the backend's own data folder.
DATA_DIR=

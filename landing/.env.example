# Copy this file to landing/.env and adjust for the environment.

# Base URL of the FastAPI backend.
# Leave empty to call the API on the current origin, which is what the
# development proxy on /api expects. Set a full origin, for example
# http://127.0.0.1:8000, to call the backend directly.
VITE_API_BASE_URL=

# The backend the development server forwards the API to. The setup script
# writes this, and it follows the PORT in backend/.env, so that the landing
# page keeps talking to the backend when the port is changed.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# URL of the news application embedded in the workspace.
VITE_NEWS_APP_URL=http://localhost:5173/

# URL of Peer Benchmarking, embedded in the workspace.
VITE_BENCHMARKING_APP_URL=http://localhost:8077/

# URL of the Data Summarizer (the Regulatory Sentinel), embedded in the workspace.
VITE_SUMMARIZER_APP_URL=http://localhost:8090/

# URL of the Data Analyzer, embedded in the workspace.
VITE_ANALYZER_APP_URL=http://localhost:8095/

# URL of the SQL Genie, embedded in the workspace. Point this at wherever the
# application is served, and add its origin to the list below.
VITE_SQL_GENIE_APP_URL=http://localhost:8080/

# Origins the landing page accepts session messages from.
VITE_ALLOWED_CHILD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://newsintel.pnbbank.in:5173,http://localhost:8077,http://127.0.0.1:8077,http://localhost:8090,http://127.0.0.1:8090,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8095,http://127.0.0.1:8095

# Copy this file to backend/.env and populate local values.
# The backend loads .env relative to the directory it is started from,
# so run uvicorn from inside backend/.
#
# A .env in the repository root is read as a fallback, so either
# location works. backend/.env takes precedence.

DATABASE_URL=sqlite:///news.db

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=qwen3:8b

TIMEZONE=Asia/Kolkata

NEWS_CUTOFF_DATE=2026-06-20

# Required. The backend refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-secret

JWT_ALGORITHM=HS256

JWT_EXPIRATION_MINUTES=480

# Comma-separated browser origins allowed to call the API.
# 5173 = news frontend, 5174 = landing page hub.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://newsintel.pnbbank.in:5173,http://localhost:5174,http://127.0.0.1:5174,http://newsintel.pnbbank.in:5174

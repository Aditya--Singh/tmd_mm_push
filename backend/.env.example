# Copy this file to backend/.env and populate local values.
# The backend loads .env relative to the directory it is started from,
# so run uvicorn from inside backend/.
#
# A .env in the repository root is read as a fallback, so either
# location works. backend/.env takes precedence.

DATABASE_URL=sqlite:///news.db

# The port the backend of the hub listens on.
# Change it when the port is already taken on this machine, for example by a
# model server. The setup script writes the same port into landing/.env, so
# that the landing page keeps talking to the backend.
PORT=8000

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=qwen3:8b

TIMEZONE=Asia/Kolkata

NEWS_CUTOFF_DATE=2026-06-20

# Required. The backend refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-secret

JWT_ALGORITHM=HS256

JWT_EXPIRATION_MINUTES=480

# Comma-separated browser origins allowed to call the API.
# 5173 = news frontend, 5174 = landing page hub.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://newsintel.pnbbank.in:5173,http://topmgmtdash.pnbbank.in:5173,http://localhost:5174,http://127.0.0.1:5174,http://newsintel.pnbbank.in:5174,http://topmgmtdash.pnbbank.in:5174

# --- Peer Benchmarking ------------------------------------------------------
# The address of the Peer Benchmarking app, and the secret it shares with
# this server. The secret is the same value as HANDOFF_SECRET in
# benchmarking/.env. It is only ever used between the two servers and is
# never sent to a browser.
KPI_APP_URL=http://127.0.0.1:8077
KPI_HANDOFF_SECRET=

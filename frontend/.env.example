# Copy this file to frontend/.env and adjust for the environment.

# Base URL of the FastAPI backend.
# Leave empty to call the API on the current origin, which is what both
# the development proxy and a reverse proxied deployment expect. Set a
# full origin, for example http://127.0.0.1:8000, to call the backend
# directly.
VITE_API_BASE_URL=

# Origins the application accepts session messages from. These are the
# landing pages that may embed this application.
VITE_ALLOWED_PARENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://newsintel.pnbbank.in:5174

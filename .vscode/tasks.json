{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup: backend dependencies",
            "detail": "Create the virtual environment and install the backend packages",
            "type": "shell",
            "command": "uv sync --all-groups",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: news frontend dependencies",
            "detail": "Install the packages of the news dashboard",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: landing page dependencies",
            "detail": "Install the packages of the landing page hub",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/landing"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: benchmarking dependencies",
            "detail": "Create the virtual environment and install the Peer Benchmarking packages",
            "type": "shell",
            "command": "python -m venv .venv && ./.venv/bin/python -m pip install --upgrade pip && ./.venv/bin/python -m pip install -r requirements.txt",
            "options": {
                "cwd": "${workspaceFolder}/benchmarking"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: settings files",
            "detail": "Write the environment files and the secret the two servers share",
            "type": "shell",
            "command": "python scripts/make_env.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup: seed demo users",
            "detail": "Create the demo accounts, for example admin / admin@tmd26",
            "type": "shell",
            "command": "uv run python seed_users.py",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Setup: backend dependencies"
            ],
            "problemMatcher": []
        },
        {
            "label": "Setup: everything",
            "detail": "Install all dependencies, write the settings files and seed the demo users",
            "type": "shell",
            "command": "echo 'Setup finished. Run the Dev: all services task to start.'",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Setup: news frontend dependencies",
                "Setup: landing page dependencies",
                "Setup: benchmarking dependencies",
                "Setup: settings files",
                "Setup: seed demo users"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run: backend",
            "detail": "FastAPI on http://127.0.0.1:8000",
            "type": "shell",
            "command": "uv run uvicorn app.main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/backend"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+)\\s+-?\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Run: news frontend",
            "detail": "News dashboard on http://localhost:5173",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE.*ready in",
                    "endsPattern": "Local:.*http"
                }
            }
        },
        {
            "label": "Run: landing page",
            "detail": "Landing page hub on http://localhost:5174",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/landing"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE.*ready in",
                    "endsPattern": "Local:.*http"
                }
            }
        },
        {
            "label": "Run: benchmarking",
            "detail": "Peer Benchmarking on http://localhost:8077",
            "type": "shell",
            "command": "./.venv/bin/python -m kpibench.main",
            "options": {
                "cwd": "${workspaceFolder}/benchmarking"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/benchmarking"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+)\\s+-?\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "PNB Peer Benchmarking 1.0.0 ready",
                    "endsPattern": "Application startup complete"
                }
            }
        },
        {
            "label": "Dev: all services",
            "detail": "Backend, Peer Benchmarking, the Data Summarizer, the news dashboard and the landing page, each in its own terminal",
            "type": "shell",
            "command": "echo 'Starting the backend, Peer Benchmarking, the Data Summarizer, the news dashboard and the landing page.'",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Run: backend",
                "Run: benchmarking",
                "Run: the Data Summarizer",
                "Run: news frontend",
                "Run: landing page"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test: backend",
            "detail": "Authentication endpoint tests",
            "type": "shell",
            "command": "uv run pytest -q",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test: news frontend",
            "detail": "Frame session bridge tests",
            "type": "shell",
            "command": "npm test",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: landing page",
            "detail": "Hub frame bridge tests",
            "type": "shell",
            "command": "npm test",
            "options": {
                "cwd": "${workspaceFolder}/landing"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: benchmarking",
            "detail": "Hand-off and navigation tests of Peer Benchmarking",
            "type": "shell",
            "command": "./.venv/bin/python -m pytest tests -q",
            "options": {
                "cwd": "${workspaceFolder}/benchmarking"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: news feed for every role",
            "detail": "Browser test: the news feed is shown to every role that can sign in",
            "type": "shell",
            "command": "node news-roles.mjs",
            "options": {
                "cwd": "${workspaceFolder}/landing/e2e"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: hub with Peer Benchmarking",
            "detail": "Browser test: one sign-in opens the benchmarking app in the workspace",
            "type": "shell",
            "command": "node benchmarking.mjs",
            "options": {
                "cwd": "${workspaceFolder}/landing/e2e"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: all",
            "detail": "Run every test suite",
            "type": "shell",
            "command": "echo 'Running the backend, news frontend and landing page test suites.'",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Test: backend",
                "Test: news frontend",
                "Test: landing page",
                "Test: benchmarking",
                "Test: the Data Summarizer",
                "Test: the Data Analyzer",
                "Test: news feed for every role",
                "Test: hub with the Data Summarizer",
                "Test: hub with the Data Analyzer"
            ],
            "problemMatcher": []
        },
        {
            "label": "Check: lint and build",
            "detail": "Lint and build both frontend applications",
            "type": "shell",
            "command": "npm run lint && npm run build",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": []
        },
        {
            "label": "Doctor: check the platform",
            "detail": "Check that the settings, the accounts and the four services are in place",
            "type": "shell",
            "command": "python scripts/doctor.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Setup: sentinel dependencies",
            "detail": "Install the Data Summarizer and build its interface",
            "type": "shell",
            "command": "python -m pip install -r backend/requirements-dev.txt",
            "options": {
                "cwd": "${workspaceFolder}/sentinel"
            },
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Run: the Data Summarizer",
            "detail": "Serve the Data Summarizer on port 8090",
            "type": "shell",
            "command": "${workspaceFolder}/sentinel/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8090",
            "options": {
                "cwd": "${workspaceFolder}/sentinel/backend"
            },
            "isBackground": true,
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Test: the Data Summarizer",
            "detail": "Run the tests of the Data Summarizer",
            "type": "shell",
            "command": "${workspaceFolder}/sentinel/.venv/bin/python -m pytest -q",
            "options": {
                "cwd": "${workspaceFolder}/sentinel/backend"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Setup: analyzer dependencies",
            "detail": "Install the Data Analyzer and build its interface",
            "type": "shell",
            "command": "python -m pip install -r backend/requirements.txt",
            "options": {
                "cwd": "${workspaceFolder}/dataanalyzer"
            },
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Run: the Data Analyzer",
            "detail": "Serve the Data Analyzer on port 8095",
            "type": "shell",
            "command": "${workspaceFolder}/dataanalyzer/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8095",
            "options": {
                "cwd": "${workspaceFolder}/dataanalyzer/backend"
            },
            "isBackground": true,
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Test: the Data Analyzer",
            "detail": "Run the tests of the Data Analyzer",
            "type": "shell",
            "command": "${workspaceFolder}/dataanalyzer/.venv/bin/python -m pytest -q",
            "options": {
                "cwd": "${workspaceFolder}/dataanalyzer/backend"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: hub with the Data Summarizer",
            "detail": "Open the Data Summarizer in the hub and check the sign-in",
            "type": "shell",
            "command": "node summarizer.mjs",
            "options": {
                "cwd": "${workspaceFolder}/landing/e2e"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: hub with the Data Analyzer",
            "detail": "Open the Data Analyzer in the hub, share a document and check the sign-in",
            "type": "shell",
            "command": "node analyzer.mjs",
            "options": {
                "cwd": "${workspaceFolder}/landing/e2e"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}

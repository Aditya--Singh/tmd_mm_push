{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Landing page (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/landing",
            "sourceMaps": true
        },
        {
            "name": "News dashboard (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true
        },
        {
            "name": "Debug: landing page with all services",
            "detail": "Starts the backend, the news dashboard and the landing page, and opens the hub in Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/landing",
            "sourceMaps": true,
            "preLaunchTask": "Dev: all services",
            "compound": {
                "name": "Debug: landing page with all services",
                "configurations": [
                    "Backend: FastAPI",
                    "Landing page (Chrome)"
                ]
            }
        }
    ]
}
